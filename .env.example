# rag-preparer 설정 예시.
# 이 파일을 .env 로 복사한 뒤 값을 채우세요:  cp .env.example .env
# .env 는 .gitignore 에 들어 있어 git에 올라가지 않습니다. 비밀번호·키는 .env 에만 적으세요.
# 이미 설정된 환경변수가 있으면 그 값이 .env 보다 우선합니다.
# 읽는 실행 파일: run_pipeline.py, upload_indices.py,
#                term_dictionary/promote_candidate_terms.py, term_dictionary/upload_term_index.py

# ---- 공유 DB (email-ingestion과 같은 DB) ----
MYSQL_HOST=10.172.127.210
MYSQL_PORT=3306
MYSQL_DATABASE=fspas
MYSQL_USER=dbuser
MYSQL_PASSWORD=

# ---- run_pipeline.py 실행 시간 (초) ----
# 1회 실행 시간 예산. 스케줄러 최대 실행 시간(59분)보다 짧게.
RAG_PREPARER_TIME_BUDGET_SEC=3000
# 최대 실패 횟수. 넘으면 FAILED (LLM은 마지막 시도에서만 lite로 대체)
RAG_PREPARER_MAX_ATTEMPT=5
# 예전 상태 파일(_state_processed.json) 재사용 여부
RAG_USE_LEGACY_STATE=true

# ---- 재시도 대기 (초): base × 2^(실패횟수-1), 최대 max ----
PIPELINE_BACKOFF_BASE_SEC=300
PIPELINE_BACKOFF_MAX_SEC=21600

# ---- LLM (비워 두면 코드 기본값 사용) ----
# LLM_API_URL=
# LLM_TICKET=

# ---- 용어 인덱스 (비워 두면 코드 기본값 사용) ----
# TERM_RAG_URL=
# TERM_RAG_DELETE_URL=
# TERM_PASS_KEY=
# TERM_RAG_KEY=
# TERM_INDEX_NAME=rp-term-ver1

# ---- 용어 잡 1회 실행 여부 (스케줄러 사용 시 true) ----
PROMOTE_RUN_ONCE=true
TERM_SYNC_RUN_ONCE=true
